FROM node:22-alpine AS build

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

ENV NEXT_PUBLIC_DEPLOY_TARGET=""
RUN mkdir -p src/app/api/auth-lab/estado \
    && cp src/server/proxy-autenticacao.ts src/proxy.ts \
    && cp src/server/rota-diagnostico-auth-lab.ts src/app/api/auth-lab/estado/route.ts \
    && npm run build

FROM node:22-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NEXT_PUBLIC_SUPABASE_LOGIN_ENABLED=false \
    EXCELENCIA_AUTH_GUARD_ENABLED=false

COPY --from=build --chown=node:node /app ./

USER node

EXPOSE 3000

CMD ["npm", "run", "start"]
